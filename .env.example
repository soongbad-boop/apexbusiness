# Application Settings
APP_NAME="Apex Business Consultancy"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/Apexco

# Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=apex_business
DB_USER=root
DB_PASSWORD=

# Session Configuration
SESSION_NAME=apex_session
SESSION_SECURE=0
SESSION_LIFETIME=7200

# Media Uploads & Storage
UPLOAD_DIRECTORY=storage/media
UPLOAD_PUBLIC_PATH=/Apexco/storage/media
UPLOAD_MAX_BYTES=5242880

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=info@apexbusinessksa.com
MAIL_FROM_NAME="Apex Business Consultancy"
MAIL_TO_ADDRESS=info@apexbusinessksa.com
