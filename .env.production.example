# ==========================================
# APEX BUSINESS CONSULTANCY — PRODUCTION ENV
# ==========================================

# Application Settings
APP_NAME="Apex Business Consultancy"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://apexbusinessksa.com

# Database Connection (cPanel MySQL Database Wizard details)
# Note: In cPanel, database and usernames are prefixed with your cPanel username (e.g. cpaneluser_apex)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cpaneluser_apex_business
DB_USER=cpaneluser_apex_admin
DB_PASSWORD=YourStrongProductionDatabasePasswordHere!

# Session Configuration
SESSION_NAME=apex_production_session
SESSION_SECURE=1
SESSION_LIFETIME=7200

# Media Uploads & File Storage
# Absolute server path outside or inside web root
UPLOAD_DIRECTORY=/home/username/public_html/storage/media
UPLOAD_PUBLIC_PATH=/storage/media
UPLOAD_MAX_BYTES=5242880

# Mail / SMTP Settings (cPanel Webmail or Transactional Mailer like SendGrid / Postmark / Amazon SES)
MAIL_MAILER=smtp
MAIL_HOST=mail.apexbusinessksa.com
MAIL_PORT=465
MAIL_USERNAME=hello@apexbusinessksa.com
MAIL_PASSWORD=YourEmailPasswordHere
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=hello@apexbusinessksa.com
MAIL_FROM_NAME="Apex Business Consultancy"
