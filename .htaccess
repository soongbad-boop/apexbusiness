# ==========================================
# APEX BUSINESS CONSULTANCY — APACHE CONFIG
# ==========================================

Options -Indexes -MultiViews
DirectoryIndex index.html index.php

# Block sensitive paths and operational tooling before routing.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Canonical production host only; localhost and other development hosts are untouched.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?apexbusinessksa\.com$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.apexbusinessksa\.com$ [NC]
  RewriteRule ^ https://apexbusinessksa.com%{REQUEST_URI} [R=301,L,NE]

  RewriteRule ^(?:\.git|app|config|database|scripts|storage/(?:logs|rate_limits))(?:/|$) - [F,L,NC]
  RewriteRule ^deploy\.php$ - [F,L,NC]

  # Authenticated CMS routes must never fall through to the public SPA.
  RewriteCond %{REQUEST_URI} ^(.*/)?dashboard(?:\.html)?/?$ [NC]
  RewriteRule ^dashboard(?:\.html)?$ %1dashboard.php [L,NC]
  RewriteCond %{REQUEST_URI} ^(.*/)?login/?$ [NC]
  RewriteRule ^login/?$ %1login.php [L,NC]

  # Canonicalize legacy file URLs.
  RewriteCond %{THE_REQUEST} \s/index\.(html|php)[?\s] [NC]
  RewriteRule ^index\.(html|php)$ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/home/?[?\s] [NC]
  RewriteRule ^home/?$ / [R=301,L]

  # API endpoints.
  RewriteCond %{REQUEST_URI} ^(.*/)?api/ [NC]
  RewriteRule ^api/(.*)$ %1public/api/$1 [L,QSA,NC]

  # Server-rendered article/page routes.
  RewriteCond %{REQUEST_URI} ^(.*/)?blog/ [NC]
  RewriteRule ^blog/([a-z0-9-]+)/?$ %1public/blog.php?slug=$1 [L,QSA,NC]
  RewriteCond %{REQUEST_URI} ^(.*/)?insights/ [NC]
  RewriteRule ^insights/([a-z0-9-]+)/?$ %1public/blog.php?slug=$1 [L,QSA,NC]
  RewriteCond %{REQUEST_URI} ^(.*/)?page/ [NC]
  RewriteRule ^page/([a-z0-9-]+)/?$ %1public/page.php?slug=$1 [L,QSA,NC]

  # SPA shell for known public clean routes only. Unknown paths must reach the
  # branded 404 endpoint instead of being rendered as the homepage.
  RewriteCond %{REQUEST_URI} ^(.*/)?about/?$ [NC]
  RewriteRule ^about/?$ %1index.html [L,NC]
  RewriteCond %{REQUEST_URI} ^(.*/)?(?:services|insights|contact|conversation|visa-assistance|privacy-policy|terms-and-conditions|automation|advisory-session|advisors)/?$ [NC]
  RewriteRule ^(?:services|insights|contact|conversation|visa-assistance|privacy-policy|terms-and-conditions|automation|advisory-session|advisors)/?$ %1index.html [L,NC]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.*/)?[^/]+/?$ [NC]
  RewriteRule ^ %1public/404.php [L,NC]
</IfModule>

# Deny direct access to secrets, source/config artifacts and backups.
<FilesMatch "(?i)^(?:\.env(?:\..*)?|\.cpanel\.yml|composer\.(?:json|lock)|package-lock\.json)$|\.(?:sql|log|md|ini|conf|bak|old|orig|sh|ps1)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<Files "deploy.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>

# Security headers. CSP intentionally allows inline styles/scripts because the
# existing site uses inline UI templates; third-party script access is limited
# to the configured Google Analytics host.
<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests;"

  # HSTS only when Apache confirms HTTPS, avoiding accidental lock-in on local HTTP.
  SetEnvIfExpr "%{HTTPS} == 'on'" HTTPS_REQUEST
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS_REQUEST
</IfModule>

# MIME types.
<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/webp .webp
  AddType application/json .json
</IfModule>

# Compression for text assets.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser caching. HTML/PHP remains revalidated; versioned/static assets are cached.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
