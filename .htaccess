# ==========================================
# APEX BUSINESS CONSULTANCY — APACHE CONFIG
# ==========================================

# 1. Disable Directory Listings
Options -Indexes

# 2. Directory Index Priority
DirectoryIndex index.html index.php

# 3. URL Rewrites & Clean Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep the legacy dashboard URL behind the PHP session guard.
  RewriteRule ^dashboard\.html$ dashboard.php [L]

  # Forward API requests to PHP handler
  RewriteRule ^api/(.*)$ public/api/$1 [L,QSA]

  # Forward Blog and Page routes to SSR PHP templates
  RewriteRule ^blog/([a-z0-9-]+)/?$ public/blog.php?slug=$1 [L,QSA]
  RewriteRule ^page/([a-z0-9-]+)/?$ public/page.php?slug=$1 [L,QSA]

  # Serve the SPA shell for clean client-side routes (History API routing in app.js)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(home|about|services|insights(/[a-z0-9-]+)?|contact|privacy-policy|terms-and-conditions|conversation|visa-assistance|automation|advisory-session|advisors)/?$ index.html [L]
</IfModule>

# 4. Security & Access Restrictions for Sensitive Files & Folders
<FilesMatch "^(\.env.*|\.git.*|\.cpanel\.yml|.*\.sql|.*\.log|.*\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 5. Protect Core Source Directories & Sensitive Scripts
<IfModule mod_rewrite.c>
  RewriteRule ^(app|config|database|storage/logs)/ - [F,L,NC]
</IfModule>

# 5b. Block direct web access to deploy.php
#     It must be run via CLI: php deploy.php
#     HTTP access is only allowed if DEPLOY_SECRET env-var is configured on the server.
#     Uncomment the lines below to fully block web-triggered deploys:
# <Files "deploy.php">
#   Require all denied
# </Files>

# 6. Security Headers
<IfModule mod_headers.c>
  # Remove PHP/server version fingerprinting
  Header always unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # HSTS: Enforce HTTPS for 1 year once SSL is active on cPanel
  # IMPORTANT: Only uncomment this AFTER SSL is working and tested
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Content Security Policy
  # Allows self-hosted assets + Google Fonts + Unsplash images (used in blog/CMS)
  # Update trusted sources to match your actual external dependencies.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
</IfModule>

# 7. MIME Types & Caching
<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/webp .webp
  AddType application/json .json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
